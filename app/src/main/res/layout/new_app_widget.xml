<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_deck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_deck_default"
        android:textColor="#6B3FA0"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_word_default"
        android:textColor="#000000"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_definition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_definition_default"
        android:textColor="#333333"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_example"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_example_default"
        android:textColor="#666666"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:background="@drawable/app_widget_inner_view_background"
        android:padding="8dp"
        android:text="@string/widget_next"
        android:textColor="#6B3FA0"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
