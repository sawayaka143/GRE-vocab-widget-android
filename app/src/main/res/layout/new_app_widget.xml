<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top row: deck name + Learned checkbox -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_deck"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_deck_default"
            android:textColor="#6B3FA0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="●"
            android:textColor="#666666"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/widget_learned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#6B3FA0"
            android:text="@string/widget_learned"
            android:textColor="#6B3FA0"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Centered word area -->
    <LinearLayout
        android:id="@+id/widget_middle_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/widget_word_default"
            android:textColor="#000000"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_definition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/widget_definition_default"
            android:textColor="#333333"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_example"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/widget_example_default"
            android:textColor="#666666"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Full-width rounded bottom bar -->
    <TextView
        android:id="@+id/widget_reveal_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_reveal_bar_bg"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/tap_to_see_meaning"
        android:textColor="#666666"
        android:textSize="14sp" />

</LinearLayout>
